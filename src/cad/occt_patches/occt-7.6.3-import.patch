+  // Match Intersect's eight-slot parameter arrays without allocating a
+  // sequence (and touching its shared allocator) for every segment pair.
+  class LocalSectionPoints
+  {
+  public:
+    void Append (const Intf_SectionPoint& thePoint)
+    { myPoints[mySize++] = thePoint; }
+    Intf_SectionPoint& operator() (Standard_Integer theIndex)
+    { return *myPoints[theIndex - 1]; }
+  private:
+    std::array<std::optional<Intf_SectionPoint>, 8> myPoints;
+    Standard_Integer mySize = 0;
+  };
+
+
+  // Retain the original expanded-box test, but avoid visiting every pair of
+  // segments for densely sampled curves. Candidates are sorted so Intersect()
+  // receives exactly the same pairs in the same order as the nested loops.
+  class PolygonSegments
+  {
+  public:
+    typedef NCollection_UBTree<Standard_Integer, Bnd_Box2d> Tree;
+    struct Selector : public Tree::Selector
+    {
+      Bnd_Box2d Box;
+      std::vector<Standard_Integer> Indices;
+      Standard_Boolean Reject (const Bnd_Box2d& theBox) const override
+      { return Box.IsOut(theBox); }
+      Standard_Boolean Accept (const Standard_Integer& theIndex) override
+      { Indices.push_back(theIndex); return Standard_True; }
+    };
+
+    explicit PolygonSegments (const Intf_Polygon2d& thePolygon)
+    {
+      const Standard_Integer aCount = thePolygon.NbSegments();
+      const Standard_Real aDeflection = thePolygon.DeflectionOverEstimation();
+      Points.resize(aCount);
+      NCollection_UBTreeFiller<Standard_Integer, Bnd_Box2d> aFiller(myTree);
+      for (Standard_Integer i = 1; i <= aCount; ++i)
+      {
+        std::pair<gp_Pnt2d, gp_Pnt2d>& aPoints = Points[i - 1];
+        thePolygon.Segment(i, aPoints.first, aPoints.second);
+        Bnd_Box2d aBox;
+        aBox.Add(aPoints.first);
+        aBox.Add(aPoints.second);
+        aBox.Enlarge(aDeflection);
+        aFiller.Add(i, aBox);
+      }
+      aFiller.Fill();
+    }
+
+    void Select (const Bnd_Box2d& theBox, Selector& theSelector) const
+    {
+      theSelector.Box = theBox;
+      theSelector.Indices.clear();
+      myTree.Select(theSelector);
+      std::sort(theSelector.Indices.begin(), theSelector.Indices.end());
+    }
+
+    std::vector<std::pair<gp_Pnt2d, gp_Pnt2d> > Points;
+  private:
+    Tree myTree;
+  };
 }
 
